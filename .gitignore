# ---- Dependencies ----
node_modules/

# ---- Build output ----
release/
dist/
out/
*.msi
*.blockmap

# ---- Generated manual artifacts ----
# Sources live in manual/ and manual/ar/; these are build products.
manual/manual.html
manual/manual-ar.html
manual/*.pdf

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Environment / secrets ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- OS / editor ----
.DS_Store
Thumbs.db
desktop.ini
.vs/
.vscode/
*.user
*.suo
*.swp

# ---- Temp ----
*.tmp
*.bak

# ---- Clone project data ----
# Clone workspaces live in <workspace>/.rea-clone and are user data, not source.
.rea-clone/
